{
  "name": "dsh-gatecraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Say what a circuit should do; get a NAND circuit proven on every input. A harness plugin around the gatecraft compiler.",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./tools": "./lib/tools.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "author": "BruceLanLan (https://github.com/BruceLanLan)",
  "homepage": "https://github.com/BruceLanLan/gatecraft/tree/main/dsh",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "gatecraft",
    "circuit",
    "nand"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
