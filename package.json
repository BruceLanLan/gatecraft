{
  "name": "gatecraft",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Freeze one small, repeated decision into a table proven on every row, checked against a person, and exported as a dependency-free module.",
  "scripts": {
    "setup": "node tools/setup.mjs",
    "check": "node tools/assert_no_sensitive_info.mjs",
    "test": "node --test tests/*.test.mjs",
    "ui": "node scripts/ui.mjs",
    "mcp": "node scripts/mcp.mjs",
    "compile:table": "node scripts/compile-table.mjs",
    "compile:grid": "node scripts/compile-grid.mjs",
    "compile:fsm": "node scripts/compile-fsm.mjs",
    "anneal:stateful": "node scripts/anneal-stateful.mjs",
    "tapeout:manifest": "node scripts/tapeout-manifest.mjs"
  },
  "license": "MIT",
  "author": "BruceLanLan (https://github.com/BruceLanLan)",
  "homepage": "https://github.com/BruceLanLan/gatecraft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceLanLan/gatecraft.git"
  },
  "keywords": [
    "circuit",
    "nand",
    "compiler",
    "natural-language",
    "verification",
    "tapeout"
  ]
}
